# AKOS production stack — copy to deploy/.env.production and adjust secrets.
# Used by deploy/docker-compose.yml (akos-api env_file).

# --- Core persistence ---
AKOS_USE_PG=true
AKOS_DATA_ROOT=/app/data
AKOS_DATABASE_URL=postgresql+psycopg://akos:akos@postgres:5432/akos
AKOS_DEFAULT_DOMAIN_TYPE=ecommerce_cs

# --- Graph (Neo4j) ---
AKOS_GRAPH_BACKEND=neo4j
AKOS_NEO4J_URI=bolt://neo4j:7687
AKOS_NEO4J_USER=neo4j
AKOS_NEO4J_PASSWORD=akos-neo4j

# --- Retrieval ---
# postgres (default Phase 2) | opensearch (optional)
AKOS_BM25_BACKEND=postgres

# --- File storage (MinIO) ---
AKOS_FILES_BACKEND=minio
AKOS_MINIO_ENDPOINT=minio:9000
AKOS_MINIO_ACCESS_KEY=akos-minio
AKOS_MINIO_SECRET_KEY=akos-minio-secret
AKOS_MINIO_BUCKET=akos
AKOS_MINIO_SECURE=false

# --- Memory hot tier (PG only; Redis adapter not implemented) ---
AKOS_MEMORY_HOT=pg

# --- LLM (OpenAI-compatible) ---
AKOS_LLM_BASE_URL=https://api.openai.com/v1
AKOS_LLM_API_KEY=
AKOS_LLM_MODEL=gpt-4o-mini

# --- Admin API auth (non-empty requires X-Admin-Token on /admin/*) ---
ADMIN_API_TOKEN=change-me-in-production
