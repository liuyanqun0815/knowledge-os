# 复制为 .env。未写的项使用 infra/settings.py 里的默认值。

# 存储：false=内存；true=PostgreSQL
AKOS_USE_PG=false
AKOS_DATABASE_URL=postgresql+psycopg://akos:akos@localhost:5432/akos
# memory | postgres | neo4j
AKOS_GRAPH_BACKEND=memory

# LLM（OpenAI 兼容；入库 / Ask / Wiki 默认需要 Key）
AKOS_LLM_BASE_URL=https://api.openai.com/v1
AKOS_LLM_API_KEY=
AKOS_LLM_MODEL=gpt-4o-mini

# 非空时 /admin/* 需要请求头 X-Admin-Token
ADMIN_API_TOKEN=

# 可选
# AKOS_RETRIEVAL_TOP_K=8
# AKOS_RETRIEVAL_GRAPH_TOP_K=20
# AKOS_RETRIEVAL_GRAPH_MAX_SEEDS=7
# AKOS_RETRIEVAL_GRAPH_PER_SEED=4
# AKOS_NEO4J_URI=bolt://localhost:7687
# AKOS_NEO4J_USER=neo4j
# AKOS_NEO4J_PASSWORD=
# AKOS_LANGSMITH_TRACING=true
# AKOS_LANGSMITH_API_KEY=
# AKOS_EMBEDDING_ENABLED=true
# AKOS_RERANK_ENABLED=false
