# AKOS 环境变量示例 — 复制为 .env 后按需修改
# 完整说明见 README.md「环境变量」一节

# ── 存储 / 数据库 ──
AKOS_DATA_ROOT=./data
AKOS_DATABASE_URL=postgresql+psycopg://akos:akos@localhost:5432/akos
# true：启用 PostgreSQL（知识库 CRUD、持久化 Claim）；false：InMemory 开发模式
AKOS_USE_PG=false

# ── 图存储（GraphPort）──
# postgres：开发（与 PG 共用）| neo4j：生产 Docker 栈 | memory：默认 InMemory
AKOS_GRAPH_BACKEND=postgres
AKOS_NEO4J_URI=bolt://localhost:7687
AKOS_NEO4J_USER=neo4j
AKOS_NEO4J_PASSWORD=akos-neo4j

# ── 文件存储（FilePort）──
# local：开发（AKOS_DATA_ROOT）| minio：生产 Docker 栈
AKOS_FILES_BACKEND=local
AKOS_DEFAULT_DOMAIN_TYPE=ecommerce_cs

# ── LLM（OpenAI 兼容 API）──
AKOS_LLM_BASE_URL=https://api.openai.com/v1
# 留空则自动跳过 LLM 后台补抽
AKOS_LLM_API_KEY=
AKOS_LLM_MODEL=gpt-4o-mini
# DeepSeek V4 默认开启 thinking；false 关闭推理（抽取/合成更快、JSON 更稳）
AKOS_LLM_THINKING=false

# ── LangSmith 可观测性（上传 ingest / LLM 补抽 / 问答 ask 全链路）──
# 方式一：标准 LangChain 环境变量（推荐）
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=lsv2_pt_...
# LANGCHAIN_PROJECT=akos
# 方式二：AKOS 前缀（启动时写入 LANGCHAIN_*）
# AKOS_LANGSMITH_TRACING=true
# AKOS_LANGSMITH_API_KEY=lsv2_pt_...
# AKOS_LANGSMITH_PROJECT=akos

# ── Hybrid 抽取（规则同步 + LLM 异步补抽）──
# 双路开启时 compile 取规则∪LLM 并集（同三元组合并，保留规则 quote）
# AKOS_EXTRACT_LLM=false 时与 Phase 2.1 规则-only 行为一致
AKOS_EXTRACT_RULES=true
AKOS_EXTRACT_LLM=true
AKOS_CHUNK_MAX_CHARS=3000
AKOS_CHUNK_MAX_PER_DOC=40
# auto | heading | general；auto 在 ≥2 个 H1/H2 时用 heading
AKOS_CHUNK_MODE=auto
# heading 模式按此级别及更高层切分（更深标题留在块内）
AKOS_CHUNK_HEADING_LEVEL=2
AKOS_EXTRACT_MIN_CONFIDENCE=0.5
# true=LLM 可自创谓词并懒注册；false=名单外进 quarantine
AKOS_EXTRACT_OPEN_PREDICATES=true
# Claim 主体绑定产品：auto|on|off（上传表单可覆盖；词表靠提示词示例，不可穷举）
AKOS_SUBJECT_BIND_MODE=auto

# ── Chunk 双索引 + Ask 合成 + Wiki LLM ──
AKOS_CHUNK_INDEX=true
AKOS_CHUNK_LLM_ENRICH=true
# save_chunks 后硬删 stale 行
AKOS_PURGE_STALE_CHUNKS=true
AKOS_RETRIEVAL_TOP_K=8
AKOS_ASK_SYNTHESIS=true
AKOS_ASK_SYNTHESIS_TEMPERATURE=0.2
AKOS_ASK_SYNTHESIS_MAX_CHUNKS=5
# 非 Claim（chunk/wiki）写入 LLM 时每条正文最大字符数（直接消费 rerank 结果）
AKOS_ASK_SYNTHESIS_CONTENT_MAX_CHARS=800
# 问句归一化：规则未命中残缺短问时是否用 LLM rewrite
AKOS_ASK_NORMALIZE_LLM=true
# 三路融合权重（Claim / Wiki 主题页 / 原文 Chunk）
AKOS_RETRIEVAL_CLAIM_WEIGHT=1.0
AKOS_RETRIEVAL_WIKI_WEIGHT=0.9
AKOS_RETRIEVAL_CHUNK_WEIGHT=0.8
AKOS_WIKI_LLM=false
AKOS_WIKI_LLM_CACHE=true
# 同库编译层增量更新；false 时 Ask 仍为双路
AKOS_WIKI_COMPILE=true
# 主题页 LLM 合并；false 则确定性模板
AKOS_WIKI_COMPILE_LLM=true
# 一期默认关：不沿 [[wikilink]] 扩展检索
AKOS_WIKI_LINK_EXPAND=false
# Wiki 目录层级（hub/leaf/snippet）；false 时保持平铺 topic- 行为
AKOS_WIKI_HIERARCHY=true
# LLM 辅助选父主题（一期默认关，仅占位）
AKOS_WIKI_HIERARCHY_LLM=false
# 编译时清理根目录遗留 topic-*.md 平铺页
AKOS_WIKI_MIGRATE_FLAT=true
# 相关主题上限（同 hub 优先）
AKOS_WIKI_MAX_RELATED=12
# 源文档字数达到该阈值时，Wiki 按「业务类目/产品名」拆多页（默认 5000）
AKOS_WIKI_SPLIT_MIN_CHARS=5000

# ── Topic cluster（主题簇）──
AKOS_TOPIC_CLUSTER=true
AKOS_TOPIC_MIN_CHUNKS=1
AKOS_TOPIC_GRAPH_CHUNKS=true
AKOS_TOPIC_LLM_SUMMARY=false
AKOS_TOPIC_CLAIM_BOOST=0.1

# ── 管理台原文预览 ──
# 超过该字节数的文档拒绝返回全文（默认 1 MiB）
AKOS_SOURCE_CONTENT_MAX_BYTES=1048576

# ── 管理台鉴权（非 AKOS_ 前缀，见 app/admin_auth.py）──
# 非空时 /admin/* 需在请求头携带 X-Admin-Token
ADMIN_API_TOKEN=
